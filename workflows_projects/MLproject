name: sante_prediction
python_env: python_env.yaml
entry_points:
  train:
    parameters:
      max_depth: 
        type: int
        default: None
      
      n_estimators:
        type: int
        default: 100

    command: "python3 train.py {max_depth} {n_estimators}"
  evaluate:
    parameters:
      run_id:
        type: string
    command: "python3 evaluate.py {run_id}" 